rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
  match /b/oceankart-83bbd.firebasestorage.app/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
  match /b/oceankart-83bbd.appspot.com/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
