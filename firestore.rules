rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/admin/$(request.auth.uid)) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Admin Collection: Read & write for authenticated users
    match /admin/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow the user to update their own verification status and details, or allow admins
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      // IMPORTANT: Rules for the products subcollection inside the user document
      match /products/{productId} {
        allow read: if true;
        // Only the owner of the shop (userId) or an admin can write products
        allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
      
      // IMPORTANT: Rules for the cart subcollection
      match /cart/{cartItemId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // IMPORTANT: Rules for the saved addresses subcollection
      match /addresses/{addressId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // IMPORTANT: Rules for the notifications subcollection
      match /notifications/{notificationId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /shop_owners/{shopOwnerId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == shopOwnerId || isAdmin());
      allow delete: if isAdmin();

      match /products/{productId} {
        allow read: if true;
        allow write: if isAuthenticated() && (request.auth.uid == shopOwnerId || isAdmin());
      }

      match /notifications/{notificationId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /delivery_partners/{partnerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == partnerId || isAdmin());
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /orders/{orderId} {
      // Customers, Shop owners, Delivery partners, and Admins can access and manage orders
      allow read, write: if isAuthenticated();
    }

    match /inventory/{itemId} {
      allow read, write: if isAuthenticated();
    }
    
    // Add this at the bottom of your rules file, outside of other match blocks
    match /{path=**}/products/{productId} {
      allow read: if true; // Allows anyone to see products in the dashboard
    }

    match /{path=**}/notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // Categories Collection: Read & write access
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Locations Collection: Read & write access
    match /locations/{locationId} {
      allow read, write: if true;
    }
  }
}
