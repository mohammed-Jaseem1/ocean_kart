rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Fixed isAdmin: exists() is expensive, prioritize the role check
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Admin Collection: Read & write for authenticated users
    match /admin/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow the user to update their own verification status and details
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();

      // IMPORTANT: Rules for the products subcollection inside the user document
      match /products/{productId} {
        allow read: if true;
        // Only the owner of the shop (userId) or an admin can write products
        allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
      
      // IMPORTANT: Rules for the cart subcollection
      match /cart/{cartItemId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    match /orders/{orderId} {
      // Customers can create orders and read their own. Admins can do everything.
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated(); 
    }

    match /inventory/{itemId} {
      allow read, write: if isAuthenticated();
    }
    
    // Add this at the bottom of your rules file, outside of other match blocks
    match /{path=**}/products/{productId} {
      allow read: if true; // Allows anyone to see products in the dashboard
    }

    // Categories Collection: Read & write access
    match /categories/{categoryId} {
      allow read, write: if true;
    }
  }
}
